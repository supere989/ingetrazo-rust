inline uint4 encoded(float4 v){return uint4(rint(v*255.0f));}
inline float4 source_decode(uint4 q){return float4(as_type<float>(source_unorm_bits[q.x]),as_type<float>(source_unorm_bits[q.y]),as_type<float>(source_unorm_bits[q.z]),as_type<float>(source_unorm_bits[q.w]));}
inline float4 ordered_resolve(float4 a,float4 b,float4 c,float4 d){
 uint4 qa=encoded(a),qb=encoded(b),qc=encoded(c),qd=encoded(d);
 if(all(qa==qb)&&all(qa==qc)&&all(qa==qd))return a;
 float4 s=source_decode(qa)+source_decode(qb);
 s=s+source_decode(qc);
 s=s+source_decode(qd);
 s=s*0.25f;
 s=s*255.0f;
 uint4 q=uint4(rint(s));
 return source_decode(q);
}
kernel void source_resolve_compute(texture2d_ms<float,access::read> input [[texture(0)]],texture2d<float,access::write> output [[texture(1)]],uint2 p [[thread_position_in_grid]]){
 if(p.x>=output.get_width()||p.y>=output.get_height())return;
 output.write(ordered_resolve(input.read(p,0),input.read(p,1),input.read(p,2),input.read(p,3)),p);
}

#if SOURCE_TILE
struct ResolveColor{float4 value [[color(0)]];};
kernel void source_resolve_tile(imageblock<ResolveColor> block,ushort2 p [[thread_position_in_threadgroup]]){
 ushort count=block.get_num_colors(p);
 if(count<=1)return;
 float4 samples[4]={float4(0),float4(0),float4(0),float4(0)};
 ushort covered=0;
 for(ushort color=0;color<count;color++){
  float4 value=block.read(p,color,imageblock_data_rate::color).value;
  ushort mask=block.get_color_coverage_mask(p,color)&ushort(0xF);
  if(covered&mask)return;
  covered|=mask;
  for(ushort slot=0;slot<4;slot++)if(mask&(1u<<slot))samples[slot]=value;
 }
 if(covered!=ushort(0xF))return;
 block.write(ResolveColor{ordered_resolve(samples[0],samples[1],samples[2],samples[3])},p,ushort(0xF));
}

#endif
