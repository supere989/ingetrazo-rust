+    /// Arm host-only bytecode fuel. Exhaustion remains poisoned until host reset.
+    pub fn host_budget_arm(&self, fuel: u64) -> Result<(), &'static str> {
+        if self.host_poison.get() || self.host_fuel.get().is_some() { return Err("Host execution requires journal discard/reset"); }
+        self.host_fuel.set(Some(fuel)); Ok(())
+    }
+    pub fn host_budget_poisoned(&self) -> bool { self.host_poison.get() }
+    pub fn host_budget_active(&self) -> bool { self.host_fuel.get().is_some() }
+    /// Host obligation: discard staged document mutations before this reset.
+    /// No Python binding exists. This prototype does not bound native builtins.
+    pub fn host_budget_reset_after_discard(&self) { self.host_fuel.set(None); self.host_poison.set(false); }
+    #[inline]
+    pub fn host_budget_tick(&self) -> PyResult<()> {
+        if self.host_poison.get() { return Err(self.new_runtime_error("Host bytecode budget exhausted".to_owned())); }
+        if let Some(fuel) = self.host_fuel.get() {
+            if fuel == 0 { self.host_poison.set(true); return Err(self.new_runtime_error("Host bytecode budget exhausted".to_owned())); }
+            self.host_fuel.set(Some(fuel - 1));
+        }
+        Ok(())
+    }
